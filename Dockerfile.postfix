# =============================================================================
# mimedefang/postfix  –  three build targets
#
#   docker build --target ci   -t mimedefang/postfix:ci   .    <- CI
#   docker build --target prod -t mimedefang/postfix:latest .  <- production image
#   docker build               -t mimedefang/postfix:latest .  <- same as prod (default)
#
# Build-time ARGs (override with --build-arg NAME=value):
#
#   BASE_IMAGE        Base OS image            (default: almalinux:9)
#   MIMEDEFANG_VER    MIMEDefang release tag   (default: v3.7)
#
# Run-time ENV (set with -e NAME=value or env_file):
#
#   MAIL_DOMAIN       Primary mail domain           (default: example.com)
#   MAIL_HOST         FQDN of this host             (default: mail.example.com)
#   RELAY_HOST        Postfix relayhost             (optional, e.g. [smtp.isp.com]:587)
#   RELAY_NETS        mynetworks value              (default: 127.0.0.0/8 [::1]/128)
#   MAX_WORKERS       Multiplexor max workers       (default: 10)
#   MIN_WORKERS       Multiplexor min workers       (default: 2)
#   MAX_IDLE          Max idle workers              (default: 2)
#   SPOOL_DIR         MIMEDefang spool dir          (default: /var/spool/MIMEDefang)
#   SMTP_PORT         SMTP listen port              (default: 25)
#   ENABLE_SUBMISSION Also listen on port 587       (default: no)
#   TZ                Container timezone            (default: UTC)
#
# Volume mount points (prod):
#   /etc/mail/mimedefang-filter   – your Perl filter (bind-mount to customise)
#   /var/spool/MIMEDefang         – spool (persist across restarts)
#   /var/spool/MD-Quarantine      – quarantine directory
#   /etc/postfix/extra.cf         – optional extra Postfix main.cf snippets
#   /etc/pki/tls/mimedefang       – TLS key + cert PEM files
# =============================================================================

ARG BASE_IMAGE=almalinux:9
ARG MIMEDEFANG_VER=v3.7

# ---------------------------------------------------------------------------
# Stage: base-pkgs  –  runtime packages shared by ci and prod
# ---------------------------------------------------------------------------
FROM ${BASE_IMAGE} AS base-pkgs

RUN dnf -y update && \
    dnf config-manager --set-enabled crb && \
    dnf -y install epel-release && \
    dnf -y install \
        postfix \
        perl \
        perl-MIME-tools \
        perl-MailTools \
        perl-Digest-SHA \
        perl-IO-Socket-SSL \
        perl-JSON \
        perl-libwww-perl \
        perl-HTML-Parser \
        tzdata procps-ng rsyslog nc \
        perl-AnyEvent \
        perl-Net-DNS \
        perl-Mail-DKIM \
        perl-Mail-SPF \
        perl-Archive-Zip \
        perl-Unix-Syslog \
        spamassassin \
    && dnf clean all && rm -rf /var/cache/dnf

# ---------------------------------------------------------------------------
# Stage: devel-pkgs  –  adds everything needed to compile MIMEDefang
#
# NOTE: postfix ships its own libmilter on RHEL/Alma; on Debian/Ubuntu you
#       would use libmilter-dev instead.  The postfix-milter compat layer is
#       provided by the postfix package itself on AlmaLinux 9.
# ---------------------------------------------------------------------------
FROM base-pkgs AS devel-pkgs

RUN dnf -y install \
        gcc make autoconf automake \
        rpm-build \
        sendmail-milter-devel \
        perl-devel \
        perl-CPAN \
        perl-Test-Class \
        perl-Test-Most \
        perl-File-Find-Rule \
        git tar gzip \
    && dnf clean all && rm -rf /var/cache/dnf

# ---------------------------------------------------------------------------
# Stage: ci  –  full build+test environment (devel files KEPT)
#
# The CI workflow bind-mounts the repo root to /tests and calls
#   sh t/dockerPostfix.sh
# which runs ./configure, make, make test inside the container.
# ---------------------------------------------------------------------------
FROM devel-pkgs AS ci

LABEL org.opencontainers.image.title="mimedefang/postfix (CI)" \
      org.opencontainers.image.description="MIMEDefang + Postfix – CI/CD build & test image" \
      org.opencontainers.image.source="https://github.com/The-McGrail-Foundation/MIMEDefang"

# Create the defang user and spool dirs so tests that start the daemon work
RUN useradd -r -s /sbin/nologin -d /var/spool/MIMEDefang defang 2>/dev/null || true && \
    mkdir -p /var/spool/MIMEDefang /var/spool/MD-Quarantine && \
    chown defang:defang /var/spool/MIMEDefang /var/spool/MD-Quarantine && \
    chmod 700 /var/spool/MIMEDefang /var/spool/MD-Quarantine

WORKDIR /tests

# Default command mirrors docker-compose-postfix.yml
CMD ["sh", "t/dockerPostfix.sh"]

# ---------------------------------------------------------------------------
# Stage: builder  –  compile a release tarball for the production image
# ---------------------------------------------------------------------------
FROM devel-pkgs AS builder

ARG MIMEDEFANG_VER

WORKDIR /build

RUN git clone --depth 1 --branch ${MIMEDEFANG_VER} \
        https://github.com/The-McGrail-Foundation/MIMEDefang.git . && \
    autoreconf -fvi && \
    ./configure \
        --sysconfdir=/etc \
        --with-confsubdir=mail \
        --with-spooldir=/var/spool/MIMEDefang \
        --with-quarantinedir=/var/spool/MD-Quarantine && \
    make -j"$(nproc)" && \
    make install DESTDIR=/install

# ---------------------------------------------------------------------------
# Stage: prod  –  lean runtime image (no compiler, no headers)
# ---------------------------------------------------------------------------
FROM base-pkgs AS prod

ARG MIMEDEFANG_VER
LABEL org.opencontainers.image.title="mimedefang/postfix" \
      org.opencontainers.image.description="MIMEDefang + Postfix – production image" \
      org.opencontainers.image.version="${MIMEDEFANG_VER}" \
      org.opencontainers.image.source="https://github.com/The-McGrail-Foundation/MIMEDefang" \
      org.opencontainers.image.licenses="GPL-2.0"

COPY --from=builder /install/ /

ENV MAIL_DOMAIN="example.com" \
    MAIL_HOST="mail.example.com" \
    RELAY_HOST="" \
    RELAY_NETS="127.0.0.0/8 [::1]/128" \
    MAX_WORKERS="10" \
    MIN_WORKERS="2" \
    MAX_IDLE="2" \
    SPOOL_DIR="/var/spool/MIMEDefang" \
    SMTP_PORT="25" \
    ENABLE_SUBMISSION="no" \
    TZ="UTC"

RUN useradd -r -s /sbin/nologin -d /var/spool/MIMEDefang defang 2>/dev/null || true && \
    mkdir -p \
        /var/spool/MIMEDefang \
        /var/spool/MD-Quarantine \
        /etc/pki/tls/mimedefang \
        /run/mimedefang && \
    chown defang:defang \
        /var/spool/MIMEDefang \
        /var/spool/MD-Quarantine \
        /run/mimedefang && \
    chmod 700 /var/spool/MIMEDefang /var/spool/MD-Quarantine

COPY --chmod=644 docker/mimedefang-filter.default /etc/mail/mimedefang-filter.default
COPY --chmod=755 docker/entrypoint-postfix.sh      /entrypoint.sh

VOLUME ["/etc/mail/mimedefang-filter", \
        "/var/spool/MIMEDefang", \
        "/var/spool/MD-Quarantine", \
        "/etc/postfix/extra.cf", \
        "/etc/pki/tls/mimedefang"]

EXPOSE 25 587

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD echo QUIT | nc -w3 127.0.0.1 ${SMTP_PORT} | grep -q "220" || exit 1

ENTRYPOINT ["/entrypoint.sh"]

# Make prod the default target
FROM prod
